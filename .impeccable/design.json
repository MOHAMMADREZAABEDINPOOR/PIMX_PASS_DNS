    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action with a small press movement.",
      "html": "<button class=\"ds-primary\" type=\"button\">Start scan<svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:11px 20px;border:0;border-radius:10px;font-size:13px;font-weight:600;line-height:1.75;text-align:center;cursor:pointer;transition:background-color var(--motion-fast,180ms),color var(--motion-fast,180ms),transform var(--motion-normal,320ms) var(--ease,cubic-bezier(.22,1,.36,1));font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;background:var(--accent,#2d63e7);color:var(--accent-ink,#ffffff)}.ds-primary:hover:not(:disabled){background:#2154d0}.ds-primary:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{opacity:.42;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms}}.ds-primary svg{transition:transform var(--motion-normal,320ms) var(--ease,cubic-bezier(.22,1,.36,1))}.ds-primary:hover svg{transform:translate(2px,-2px)}:host([dir=rtl]) .ds-primary:hover svg{transform:translate(-2px,-2px)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Raised surface for supporting actions.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Save collection</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:11px 20px;border:0;border-radius:10px;font-size:13px;font-weight:600;line-height:1.75;text-align:center;cursor:pointer;transition:background-color var(--motion-fast,180ms),color var(--motion-fast,180ms),transform var(--motion-normal,320ms) var(--ease,cubic-bezier(.22,1,.36,1));font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;background:var(--surface-raised,#202b3c);color:var(--ink,#eff4fc)}.ds-secondary:hover:not(:disabled){background:var(--surface-hover,#293850)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-secondary:active:not(:disabled){transform:translateY(1px)}.ds-secondary:disabled{opacity:.42;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:.01ms}}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named compact action; selected favorites use response ice.",
      "html": "<button class=\"ds-icon\" type=\"button\" aria-label=\"Favorite: Cloudflare\" aria-pressed=\"false\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m12 3 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2L12 17.3l-5.7 2.9 1.1-6.2L3 9.6l6.3-.9z\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;flex-shrink:0;border:0;border-radius:8px;background:transparent;color:var(--muted,#a4b2c8);cursor:pointer;transition:background .2s,color .2s}.ds-icon:hover{background:var(--surface-raised,#202b3c);color:var(--ink,#eff4fc)}.ds-icon[aria-pressed=true]{color:var(--positive,#a6c5ff)}.ds-icon:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-icon{transition-duration:.01ms}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Ground-colored field with a visible caption and focus border.",
      "html": "<label class=\"ds-field\"><span>Connection name</span><input class=\"ds-field-input\" value=\"My network\" maxlength=\"60\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;min-width:0;font-size:14px;line-height:1.75;color:var(--ink,#eff4fc);font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-field>span{font-size:13px;color:var(--muted,#a4b2c8)}.ds-field-input{min-width:0;min-height:50px;width:100%;padding:11px 14px;border:1px solid var(--line,#314059);border-radius:9px;background:var(--ground,#0d1119);color:var(--ink,#eff4fc);font:inherit;caret-color:var(--focus,#2d63e7)}.ds-field-input::placeholder{color:var(--subtle,#8898b0);opacity:1}.ds-field-input:focus{border-color:var(--focus,#2d63e7)}.ds-field-input:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-field-input:disabled{opacity:.42;cursor:not-allowed}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "workspace-navigation",
      "description": "Visible destinations with tonal selection and a two-column phone layout.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Laboratory tools\"><button type=\"button\" aria-current=\"page\">Scan</button><button type=\"button\">History</button><button type=\"button\">Favorites</button><button type=\"button\">Domain</button><button type=\"button\">Status</button><button type=\"button\">Setup</button></nav>",
      "css": ".ds-nav{display:flex;gap:5px;overflow-x:auto;padding:6px;border-radius:12px;background:var(--surface,#161d29);font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-nav button{display:inline-flex;flex:1 0 auto;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:9px 12px;border:0;border-radius:7px;background:transparent;color:var(--muted,#a4b2c8);font:inherit;font-size:13px;white-space:nowrap;cursor:pointer;transition:background var(--motion-fast,180ms),color var(--motion-fast,180ms)}.ds-nav button[aria-current=page]{background:var(--surface-raised,#202b3c);color:var(--ink,#eff4fc)}.ds-nav button:hover{color:var(--ink,#eff4fc)}.ds-nav button:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}@media(max-width:540px){.ds-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible;padding:6px;border-radius:12px;gap:5px}.ds-nav button{min-width:0;min-height:44px;padding:8px;gap:6px;white-space:normal}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition-duration:.01ms}}"
    },
    {
      "name": "Purpose selection",
      "kind": "chip",
      "refersTo": "purpose-selected",
      "description": "Pressed state gives the chosen scan purpose a cobalt surface.",
      "html": "<div class=\"ds-purpose\" role=\"group\" aria-label=\"What matters to you?\"><button type=\"button\" aria-pressed=\"true\">Everyday</button><button type=\"button\" aria-pressed=\"false\">Gaming</button><button type=\"button\" aria-pressed=\"false\">Privacy</button><button type=\"button\" aria-pressed=\"false\">Family</button></div>",
      "css": ".ds-purpose{display:flex;flex-wrap:wrap;gap:8px;font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-purpose button{min-height:38px;padding:7px 19px;border:0;border-radius:7px;background:transparent;color:var(--muted,#a4b2c8);font:inherit;font-size:13px;cursor:pointer}.ds-purpose button[aria-pressed=true]{background:var(--accent,#2d63e7);color:var(--accent-ink,#ffffff)}.ds-purpose button:not([aria-pressed=true]):hover{background:var(--surface,#161d29)}.ds-purpose button:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-purpose button:disabled{opacity:.42;cursor:not-allowed}@media(max-width:540px){.ds-purpose{justify-content:space-between;gap:3px}.ds-purpose button{min-height:38px;padding:5px 10px}}@media(max-width:350px){.ds-purpose button{flex:1}}"
    },
    {
      "name": "Resolver row",
      "kind": "card",
      "refersTo": "resolver-row",
      "description": "Unmeasured catalog row preserves method text and named actions at narrow widths.",
      "html": "<article class=\"ds-resolver\"><div class=\"ds-resolver-main\"><button class=\"ds-row-icon ds-row-favorite\" type=\"button\" aria-label=\"Favorite: Cloudflare\" aria-pressed=\"false\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m12 3 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2L12 17.3l-5.7 2.9 1.1-6.2L3 9.6l6.3-.9z\"/></svg></button><div class=\"ds-provider\" aria-hidden=\"true\">C</div><div class=\"ds-provider-name\"><h3 dir=\"auto\">Cloudflare</h3><span>DoH</span></div><div class=\"ds-metric\"><strong>Ready to test</strong><span>Real DoH query</span></div><label class=\"ds-compare\"><input type=\"checkbox\" aria-label=\"Compare Cloudflare\"><span>Compare</span></label><button class=\"ds-row-icon\" type=\"button\" aria-label=\"Details for Cloudflare\" aria-expanded=\"false\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6\"/></svg></button></div></article>",
      "css": ".ds-resolver{background:var(--surface,#161d29);border-radius:11px;min-width:0;color:var(--ink,#eff4fc);transition:background .2s;font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-resolver:hover{background:var(--surface-raised,#202b3c)}.ds-resolver.ds-selected{background:var(--surface-raised,#202b3c)}.ds-resolver-main{display:flex;align-items:center;gap:15px;min-height:96px;padding:20px}.ds-row-icon{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;border:0;border-radius:8px;background:transparent;color:var(--muted,#a4b2c8);cursor:pointer;transition:background .2s,color .2s}.ds-row-favorite{width:30px;height:35px}.ds-row-icon:hover{background:var(--surface-raised,#202b3c);color:var(--ink,#eff4fc)}.ds-row-icon[aria-pressed=true]{color:var(--positive,#a6c5ff)}.ds-row-icon:focus-visible,.ds-compare input:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-provider{display:grid;place-items:center;width:39px;height:39px;flex-shrink:0;border-radius:9px;background:var(--surface-raised,#202b3c);color:#e7b27b;font-size:21px;font-weight:800}.ds-provider-name{flex:1;min-width:0}.ds-provider-name h3{margin:0;font-size:15px;font-weight:700;overflow-wrap:anywhere;text-align:start}.ds-provider-name>span{display:block;margin-top:5px;color:var(--muted,#a4b2c8);font-size:13px}.ds-metric{min-width:112px;text-align:end}.ds-metric strong{display:block;font-size:14px;font-weight:600;color:var(--muted,#a4b2c8)}.ds-metric>span{display:block;margin-top:6px;color:var(--muted,#a4b2c8);font-size:13px}.ds-compare{display:flex;align-items:center;gap:6px;margin-inline-start:10px;font-size:13px;color:var(--muted,#a4b2c8);cursor:pointer}.ds-compare input{width:17px;height:17px;accent-color:var(--focus,#2d63e7)}@media(max-width:780px){.ds-resolver-main{padding:16px;gap:11px}.ds-provider{width:34px;height:34px;font-size:18px}.ds-metric{min-width:80px}.ds-compare{margin:0}.ds-compare>span{display:none}}@media(max-width:540px){.ds-resolver-main{flex-wrap:wrap;padding:14px 10px;gap:14px 10px}.ds-provider-name{flex-basis:calc(100% - 130px)}.ds-provider-name h3{font-size:14px}.ds-provider-name>span{margin-top:2px}.ds-row-favorite{width:26px}.ds-provider{width:29px;height:29px;border-radius:6px;font-size:16px}.ds-metric{flex:1;flex-basis:calc(100% - 88px);min-width:0;text-align:start;padding-inline-start:0}.ds-metric>span{display:block;margin-inline-start:0}.ds-compare{padding:5px}.ds-row-icon:last-child{width:31px;height:31px}}@media(prefers-reduced-motion:reduce){.ds-resolver,.ds-row-icon{transition-duration:.01ms}}@media(max-width:780px){.ds-resolver-main{padding:20px;gap:15px}.ds-provider-name>span{font-size:12px}}@media(max-width:540px){.ds-resolver-main{padding:17px 13px;gap:14px 10px}.ds-provider-name>span,.ds-metric>span{font-size:12px}.ds-metric strong{font-size:13px}}"
    },
    {
      "name": "Source listbox",
      "kind": "custom",
      "refersTo": "source-trigger",
      "description": "Shared public/admin selector with optional label/description search, eighty-row increments and dialog-aware portals; this isolated appearance preview omits runtime filtering and keyboard behavior.",
      "html": "<div class=\"ds-source\"><button class=\"ds-source-trigger\" type=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"true\"><span>Recommended DoH</span><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></button><div class=\"ds-source-search\"><input type=\"search\" aria-label=\"Search resolvers\" placeholder=\"Search a name or address?\"></div><div class=\"ds-source-menu\" role=\"listbox\" aria-label=\"Test source\"><div class=\"ds-source-option ds-source-selected\" role=\"option\" aria-selected=\"true\" tabindex=\"0\"><span class=\"ds-source-icon\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M8.5 8.5a5 5 0 0 0 0 7m7-7a5 5 0 0 1 0 7M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14\"/></svg></span><span class=\"ds-source-copy\"><strong>Recommended DoH</strong><small>Resolvers the browser can query directly</small></span><span class=\"ds-source-check\"><svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m5 12 4 4L19 6\"/></svg></span></div></div></div>",
      "css": ".ds-source{max-width:420px;color:var(--ink,#eff4fc);font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-source-trigger{display:flex;align-items:center;gap:11px;width:100%;min-height:50px;padding:12px 14px;border:1px solid var(--focus,#2d63e7);border-radius:9px;background:var(--ground,#0d1119);color:inherit;font:inherit;font-size:14px;text-align:start;cursor:pointer;transition:border-color var(--motion-fast,180ms),background var(--motion-fast,180ms)}.ds-source-trigger>span{flex:1}.ds-source-trigger>svg{transform:rotate(180deg);color:var(--muted,#a4b2c8)}.ds-source-trigger:hover{background:var(--surface,#161d29)}.ds-source-trigger:focus-visible,.ds-source-option:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-source-menu{margin-top:8px;padding:6px;border:1px solid var(--line,#314059);border-radius:13px;background:var(--surface,#161d29);box-shadow:0 16px 45px #0003}.ds-source-option{display:flex;align-items:center;gap:12px;padding:13px 12px;border-radius:8px;cursor:pointer;transition:background-color 100ms}.ds-source-option:hover,.ds-source-option:focus-visible,.ds-source-selected{background:var(--surface-raised,#202b3c)}.ds-source-icon{display:grid;place-items:center;width:38px;height:38px;flex-shrink:0;border-radius:9px;background:var(--ground,#0d1119);color:var(--muted,#a4b2c8)}.ds-source-selected .ds-source-icon{background:var(--accent,#2d63e7);color:#fff}.ds-source-copy{flex:1;display:flex;flex-direction:column;gap:4px}.ds-source-copy strong{font-size:14px;font-weight:600}.ds-source-copy small{font-size:12px;line-height:1.7;color:var(--muted,#a4b2c8)}.ds-source-check{color:var(--positive,#a6c5ff)}@media(prefers-reduced-motion:reduce){.ds-source-trigger,.ds-source-option{transition:none}}.ds-source-search{margin-top:8px;padding:12px 14px;border:1px solid var(--line,#314059);border-radius:13px 13px 0 0;background:var(--surface,#161d29)}.ds-source-search input{width:100%;min-width:0;padding:7px 2px;border:0;background:transparent;color:var(--ink,#eff4fc);font:inherit;font-size:14px}.ds-source-search input::placeholder{color:var(--muted,#a4b2c8)}.ds-source-search input:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:3px}.ds-source-search+.ds-source-menu{margin-top:0;border-top:0;border-radius:0 0 13px 13px}.ds-source-copy{min-width:0;overflow-wrap:anywhere}"
    },
    {
      "name": "FAQ disclosure",
      "kind": "custom",
      "refersTo": "faq-disclosure",
      "description": "Tonal question and answer; native details makes this isolated appearance preview operable without the app runtime.",
      "html": "<details class=\"ds-faq\" open><summary><span class=\"ds-faq-icon\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M8.5 8.5a5 5 0 0 0 0 7m7-7a5 5 0 0 1 0 7M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14\"/></svg></span><span>Does this site change my device DNS?</span><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><div class=\"ds-faq-answer\"><p>No. You run a test and read the results here. To change your DNS, open the guide for your phone or computer.</p></div></details>",
      "css": ".ds-faq{border-radius:12px;background:var(--surface,#161d29);color:var(--ink,#eff4fc);overflow:hidden;font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-faq:hover,.ds-faq[open]{background:var(--surface-raised,#202b3c)}.ds-faq summary{display:flex;align-items:center;gap:16px;min-height:80px;padding:21px 23px;list-style:none;border-radius:12px;cursor:pointer;font-size:15px;font-weight:600;line-height:1.8}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary>span:nth-child(2){flex:1}.ds-faq summary>svg{color:var(--muted,#a4b2c8);transition:transform var(--motion-normal,320ms) var(--ease,cubic-bezier(.22,1,.36,1))}.ds-faq[open] summary>svg{transform:rotate(180deg);color:var(--positive,#a6c5ff)}.ds-faq summary:focus-visible{outline:2px solid var(--focus,#2d63e7);outline-offset:5px;}.ds-faq-icon{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border-radius:9px;background:var(--ground,#0d1119);color:var(--muted,#a4b2c8)}.ds-faq[open] .ds-faq-icon{color:var(--positive,#a6c5ff)}.ds-faq-answer{padding:0 25px 25px 75px}.ds-faq-answer p{margin:0;max-width:58ch;font-size:15px;line-height:2;color:var(--muted,#a4b2c8)}@media(max-width:540px){.ds-faq summary{min-height:77px;padding:16px;gap:11px;font-size:14px}.ds-faq-icon{width:31px;height:31px;border-radius:8px}.ds-faq-answer{padding:0 18px 22px}.ds-faq-answer p{font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-faq summary>svg{transition:none}}"
    },
    {
      "name": "Themed loader",
      "kind": "custom",
      "refersTo": "loader-surface",
      "description": "Stepped core and orbit geometry repeat the network motif without invented progress.",
      "html": "<div class=\"ds-loader\"><div class=\"ds-loader-object\" aria-hidden=\"true\"><span class=\"ds-loader-orbit\"></span><span class=\"ds-loader-orbit ds-loader-orbit-b\"></span><span class=\"ds-loader-core\"><i></i><i></i><i></i></span></div><div role=\"status\"><h2>A moment before we begin.</h2><p>Getting your tools ready.</p></div></div>",
      "css": ".ds-loader{display:flex;flex-direction:column;align-items:center;text-align:center;padding:35px 25px;background:var(--ground,#0d1119);color:var(--ink,#eff4fc);font-family:\"Manrope Variable\",\"Vazirmatn\",sans-serif;}.ds-loader-object{position:relative;display:grid;place-items:center;width:250px;height:250px;perspective:800px;margin-bottom:36px}.ds-loader-core{width:85px;height:100px;display:flex;flex-direction:column;justify-content:center;gap:12px;animation:ds-core-drift 3s ease-in-out infinite}.ds-loader-core i{display:block;width:85px;height:15px;background:var(--positive,#a6c5ff);transform:skewY(-12deg)}.ds-loader-core i:nth-child(2){width:62px}.ds-loader-core i:nth-child(3){width:36px}.ds-loader-orbit{position:absolute;inset:5px;border:1px solid var(--line,#314059);border-radius:50%;transform:rotateX(64deg) rotateZ(-32deg)}.ds-loader-orbit-b{inset:25px -15px;transform:rotateY(66deg) rotateZ(27deg);border-color:var(--positive,#a6c5ff);opacity:.6}.ds-loader h2{margin:0;font-size:27px;font-weight:700;line-height:1.7}.ds-loader p{margin:8px 0 0;font-size:14px;color:var(--muted,#a4b2c8)}@keyframes ds-core-drift{0%,100%{transform:rotateX(8deg) rotateY(-22deg) rotateZ(-8deg) translateY(-4px)}50%{transform:rotateX(-6deg) rotateY(12deg) rotateZ(-4deg) translateY(4px)}}@media(max-width:540px){.ds-loader-object{width:215px;height:215px;margin-bottom:28px}.ds-loader h2{font-size:22px}.ds-loader p{font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-loader-core{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Live Network Laboratory",
    "overview": "A quiet graphite instrument with cobalt actions and ice-blue responses. Broad tonal surfaces support compact resolver rows and readable explanations. The faceted network core makes requests and responses tangible; the surrounding controls stay calm and direct.\n\nPersian and English share a hierarchy with script-aware fonts and direction. Cool white text, restrained corners and visible keyboard focus support real measurements. Light mode retains the same blue material in a pale ground. The network motif connects explanatory, operational and loading surfaces.",
    "keyCharacteristics": [
      "Graphite and cool white with cobalt action and ice-blue responses.",
      "Tonal surfaces, spacious controls and readable explanatory text.",
      "A tactile network core that responds to pointer position and scan state.",
      "Script-aware Persian/English layouts with persistent light and dark themes."
    ],
    "rules": [
      {
        "name": "The State Has Text Rule",
        "body": "Pair measurement colors with response method, status or numbers. The live scene does not replace the HTML results.",
        "section": "colors"
      },
      {
        "name": "The Script First Rule",
        "body": "Preserve the language-specific font order, logical spacing and direction; keep addresses and technical values LTR inside either language.",
        "section": "typography"
      },
      {
        "name": "The Tonal Surface Rule",
        "body": "Use surface color to separate resting panels; reserve cast shadows for floating layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use cobalt for action and selection, ice blue for response, and pair status color with explicit text.",
      "**Do** preserve Persian/English font order, direction and LTR technical values.",
      "**Do** retain the fully visible two-column workspace navigation on phones.",
      "**Do** keep method labels, field captions and supporting measurements readable at the final implemented sizes.",
      "**Do** provide the static network and HTML measurement content when motion is reduced.",
      "**Do** carry language, theme and reduced-motion choices into loading and floating interfaces.",
      "**Do** use the shared themed listbox for selectable lists, with name/address search for long catalogs and the setup guide."
    ],
    "donts": [
      "**Don't** reintroduce green or chartreuse visual accents; the approved world uses cobalt and ice blue.",
      "**Don't** add cast shadows to resting panels; use the tonal surface sequence.",
      "**Don't** hide measurement methods or accessible control names when the layout narrows.",
      "**Don't** use the decorative network as the only representation of results.",
      "**Don't** add invented measurements or use success color to imply provider certification.",
      "**Don't** return device guides to an embedded tab or resolver dialog; keep their dedicated reading page."
    ]
  }
}
